# Copy to project-root .env or export variables in your shell.
# Existing environment variables take priority over .env values.
REVIEW_PROVIDER=qwen
# Supply your key locally. Never commit actual credentials.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
REVIEW_TIMEOUT_SECONDS=60
# Whole model-call budget and whole-review budget (including queue time):
REVIEW_MODEL_TIMEOUT_SECONDS=60
REVIEW_TOTAL_TIMEOUT_SECONDS=150
# Optional model overrides, using the selected provider for every stage:
# ANALYST_MODEL=
# CRITIC_MODEL=
# JUDGE_MODEL=
# Local API only: live by default; fake explicitly enables offline demonstration.
REVIEW_EXECUTION_MODE=live
# Streamlit calls the local API; its wait budget must exceed the server total.
REVIEW_API_BASE_URL=http://127.0.0.1:8000
REVIEW_API_TIMEOUT_SECONDS=180
